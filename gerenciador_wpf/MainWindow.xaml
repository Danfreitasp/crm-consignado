<Window x:Class="GerenciadorCRM.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gerenciador CRM" Width="1020" Height="805" MinWidth="800" MinHeight="660" Background="#F2F7F4" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Icon="static/icons/gerenciador_crm.ico">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#103D32"><DockPanel Margin="24,30"><StackPanel DockPanel.Dock="Top"><Border Background="#2C8A68" Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="C" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="CRM" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,17,0,0"/><TextBlock Text="GERENCIADOR" Foreground="#9BC8B6" FontSize="10" FontWeight="Bold" Margin="0,3,0,32"/><Button x:Name="MenuPainel" Content="Painel principal" Click="MostrarPainel" Style="{StaticResource Menu}" Background="#235B49"/><Button x:Name="MenuLogs" Content="Logs em tempo real" Click="MostrarLogs" Style="{StaticResource Menu}" Margin="0,6,0,0"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="Seu espaço de trabalho,&#10;mais simples." Foreground="#A7C9BA" FontSize="12" LineHeight="19" VerticalAlignment="Bottom"/></DockPanel></Border>
<Grid x:Name="PainelPrincipal" Grid.Column="1" Margin="30,25,30,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="VISÃO GERAL" Foreground="#16835C" FontSize="10" FontWeight="Bold"/><TextBlock Text="Tudo pronto para trabalhar." FontSize="27" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Controle e acompanhe seu CRM em um só lugar." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel></Grid>
<Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="STATUS DO SISTEMA" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Verificando…" FontSize="18" FontWeight="Bold" Foreground="#118050" Margin="0,7,0,6" TextWrapping="Wrap"/><TextBlock x:Name="ProjectText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="GitText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
<Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ações rápidas" FontSize="17" FontWeight="Bold"/><TextBlock Text="Tudo o que você precisa, sem usar o terminal." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,13"/><UniformGrid Columns="3" Rows="3"><Button x:Name="Abrir" Content="Abrir CRM" Tag="abrir" Style="{StaticResource Primary}" Click="Acao_Click" Margin="0,0,7,7"/><Button x:Name="Iniciar" Content="Iniciar CRM" Tag="iniciar" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,7,7"/><Button x:Name="Reiniciar" Content="Reiniciar CRM" Tag="reiniciar" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,0,7"/><Button x:Name="Fechar" Content="Fechar CRM" Tag="fechar" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,7,7"/><Button x:Name="Pull" Content="Fazer Git Pull" Tag="pull" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,7,7"/><Button x:Name="VerLog" Content="Ver log do CRM" Tag="log" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,0,7"/><Button x:Name="Pasta" Content="Abrir pasta" Tag="pasta" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,7,0"/><Button x:Name="Configuracoes" Content="Configurações" Tag="configuracoes" Style="{StaticResource ActionButton}" Click="Acao_Click" Margin="0,0,7,0"/><Button x:Name="Limpar" Content="Limpar histórico" Tag="limpar" Style="{StaticResource ActionButton}" Click="Acao_Click"/></UniformGrid></StackPanel></Border>
<Border Grid.Row="3" Style="{StaticResource Card}" MinHeight="110"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Histórico de atividades" FontSize="17" FontWeight="Bold"/><TextBlock Text="ACOMPANHAMENTO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="Historico" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="#F5F9F6" Foreground="#38534A" Padding="12" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border>
<TextBlock Grid.Row="4" Text="O CRM continua em execução se você fechar esta janela." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,0"/>
</Grid>
<Grid x:Name="TelaLogs" Grid.Column="1" Visibility="Collapsed" Margin="30,25,30,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,18"><TextBlock Text="ACOMPANHAMENTO" Foreground="#16835C" FontSize="10" FontWeight="Bold"/><TextBlock Text="Logs em tempo real" FontSize="27" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="Acompanhe as mensagens do servidor enquanto ele funciona." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
<Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Log do CRM" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="EstadoLog" Text="AGUARDANDO LOG" HorizontalAlignment="Right" Foreground="#16835C" FontSize="10" FontWeight="Bold"/></DockPanel><TextBox x:Name="LogTempoReal" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="#F5F9F6" Foreground="#38534A" Padding="14" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="Atualizado automaticamente. O log é registrado quando o CRM é iniciado pelo gerenciador."/></Grid></Border>
<TextBlock Grid.Row="2" Text="O CRM continua em execução se você fechar esta janela." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,0"/></Grid>
</Grid></Window>
